# ConfiguraÃ§Ãµes de DESENVOLVIMENTO LOCAL
# Copie este arquivo para .env.local e preencha com suas credenciais

# Database (PostgreSQL local via Docker)
DATABASE_URL=postgresql://postgres:bardo_dev_password@localhost:5432/bardo

# Server
PORT=3000
NODE_ENV=development

# JWT Secret (desenvolvimento apenas - nÃ£o use em produÃ§Ã£o!)
JWT_SECRET=dev_secret_key_change_in_production

# OpenAI (use sua chave de desenvolvimento)
OPENAI_API_KEY=sk-proj-your-key-here

# OpenAI Embeddings Model (para Knowledge Base / RAG)
# Opções: text-embedding-3-small (padrão, mais barato) ou text-embedding-3-large (melhor qualidade)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Upload Directory (para arquivos de conhecimento)
UPLOAD_DIR=/tmp/storyteller-uploads

# OAuth (não obrigatório para dev local)
# OAUTH_SERVER_URL=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
