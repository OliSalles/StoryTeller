# ConfiguraÃ§Ã£o do Ambiente
NODE_ENV=development

# Porta do servidor (padrÃ£o: 3000)
PORT=3000

# ID da aplicaÃ§Ã£o Manus
VITE_APP_ID=

# Secret para assinar tokens JWT
JWT_SECRET=your-secret-key-here-change-this-in-production

# URL do banco de dados MySQL
# Exemplo: mysql://user:password@localhost:3306/database_name
DATABASE_URL=

# OAuth Server URL
OAUTH_SERVER_URL=

# Open ID do proprietÃ¡rio
OWNER_OPEN_ID=

# Forge API (Storage) - Credenciais do serviÃ§o de armazenamento
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Analytics (opcional) - Umami ou similar
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# OpenAI Configuration (para LLM e Embeddings)
OPENAI_API_KEY=
# Modelo de embeddings para RAG (padrão: text-embedding-3-small)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Knowledge Base Configuration
# Threshold de similaridade para busca semântica (0.0 a 1.0)
# text-embedding-3-small: matches relevantes normalmente entre 0.3 e 0.5
# Padrão: 0.3
KNOWLEDGE_SIMILARITY_THRESHOLD=0.3

# Miro Board Integration (para ingestão de conhecimento)
# Obtenha em: https://developers.miro.com/
MIRO_ACCESS_TOKEN=
